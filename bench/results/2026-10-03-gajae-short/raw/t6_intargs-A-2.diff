+	const parsed = parseCoordinatorNumber(value);
 	if (parsed === 0) return 0;
 	return Math.min(Number.isFinite(parsed) && parsed > 0 ? parsed : 1000, COORDINATOR_EVENT_WATCH_TIMEOUT_MAX_MS);
 }
