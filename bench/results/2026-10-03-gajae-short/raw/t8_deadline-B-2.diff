+import { afterEach, describe, expect, it } from "bun:test";
+import { resolveCleanupDeadlineMs } from "../src/postmortem";
+
+const originalDeadline = process.env.GJC_CLEANUP_DEADLINE_MS;
+
+afterEach(() => {
+	if (originalDeadline === undefined) delete process.env.GJC_CLEANUP_DEADLINE_MS;
+	else process.env.GJC_CLEANUP_DEADLINE_MS = originalDeadline;
+});
+
+describe("postmortem cleanup deadline", () => {
+	it("clamps values above the setTimeout maximum", () => {
+		process.env.GJC_CLEANUP_DEADLINE_MS = String(2 ** 31);
+
+		expect(resolveCleanupDeadlineMs()).toBe(2_147_483_647);
+	});
+});
