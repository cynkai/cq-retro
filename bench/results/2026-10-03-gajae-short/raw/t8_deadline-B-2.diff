 const DEFAULT_CLEANUP_DEADLINE_MS = 5_000;
+// Node-compatible timers coerce larger delays to 1 ms. Keep the shutdown
+// deadline within the signed 32-bit timer range so a large override does not
+// cause cleanup to time out immediately.
+const MAX_TIMER_DELAY_MS = 2_147_483_647;
 
-function resolveCleanupDeadlineMs(): number {
+export function resolveCleanupDeadlineMs(): number {
 	const raw = process.env.GJC_CLEANUP_DEADLINE_MS;
 	if (raw === undefined || raw.trim() === "") return DEFAULT_CLEANUP_DEADLINE_MS;
 	const parsed = Number(raw);
 	if (!Number.isFinite(parsed) || parsed < 0) return DEFAULT_CLEANUP_DEADLINE_MS;
-	return parsed;
+	return Math.min(parsed, MAX_TIMER_DELAY_MS);
 }
 
