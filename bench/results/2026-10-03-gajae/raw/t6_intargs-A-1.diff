diff --git a/packages/coding-agent/test/coordinator-mcp/numeric-arguments.test.ts b/packages/coding-agent/test/coordinator-mcp/numeric-arguments.test.ts
new file mode 100644
index 0000000..5cf1dd8
--- /dev/null
+++ b/packages/coding-agent/test/coordinator-mcp/numeric-arguments.test.ts
@@ -0,0 +1,31 @@
+import { describe, expect, it } from "bun:test";
+import {
+	boundedAwaitTurnTimeoutMs,
+	boundedEventLimit,
+	boundedEventWatchTimeoutMs,
+	boundedLineCount,
+	boundedPollIntervalMs,
+} from "../../src/coordinator-mcp/server";
+
+describe("coordinator numeric arguments", () => {
+	it("accepts numbers and trimmed decimal digit strings", () => {
+		expect(boundedAwaitTurnTimeoutMs(1_500)).toBe(1_500);
+		expect(boundedAwaitTurnTimeoutMs(" 1500 ")).toBe(1_500);
+		expect(boundedEventLimit("25")).toBe(25);
+		expect(boundedEventWatchTimeoutMs("0")).toBe(0);
+		expect(boundedPollIntervalMs(" 250 ")).toBe(250);
+		expect(boundedLineCount("40")).toBe(40);
+	});
+
+	it("uses each argument's default for malformed values", () => {
+		const malformed = ["1e4", "5s", "1.5", [50]];
+
+		for (const value of malformed) {
+			expect(boundedAwaitTurnTimeoutMs(value)).toBe(1_000);
+			expect(boundedEventLimit(value)).toBe(100);
+			expect(boundedEventWatchTimeoutMs(value)).toBe(1_000);
+			expect(boundedPollIntervalMs(value)).toBe(100);
+			expect(boundedLineCount(value)).toBe(80);
+		}
+	});
+});
