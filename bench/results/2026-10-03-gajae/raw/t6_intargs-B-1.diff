diff --git a/packages/coding-agent/test/coordinator-mcp-numeric-args.test.ts b/packages/coding-agent/test/coordinator-mcp-numeric-args.test.ts
new file mode 100644
index 0000000..82ac97e
--- /dev/null
+++ b/packages/coding-agent/test/coordinator-mcp-numeric-args.test.ts
@@ -0,0 +1,31 @@
+import { describe, expect, it } from "bun:test";
+import {
+	boundedAwaitTurnTimeoutMs,
+	boundedEventWatchTimeoutMs,
+	boundedPollIntervalMs,
+	parseCoordinatorNumericArgument,
+} from "../src/coordinator-mcp/server";
+
+describe("coordinator MCP numeric arguments", () => {
+	it("accepts numbers and trimmed plain decimal strings", () => {
+		expect(parseCoordinatorNumericArgument(1.5)).toBe(1.5);
+		expect(parseCoordinatorNumericArgument(" 10000 ")).toBe(10000);
+		expect(parseCoordinatorNumericArgument("1e4")).toBeUndefined();
+		expect(parseCoordinatorNumericArgument("5s")).toBeUndefined();
+		expect(parseCoordinatorNumericArgument("1.5")).toBeUndefined();
+		expect(parseCoordinatorNumericArgument([50])).toBeUndefined();
+	});
+
+	it("uses each timeout and poll interval default for malformed values", () => {
+		for (const value of ["1e4", "5s", "1.5", [50]]) {
+			expect(boundedAwaitTurnTimeoutMs(value)).toBe(1000);
+			expect(boundedEventWatchTimeoutMs(value)).toBe(1000);
+			expect(boundedPollIntervalMs(value)).toBe(100);
+		}
+	});
+
+	it("preserves the explicit zero event-watch timeout", () => {
+		expect(boundedEventWatchTimeoutMs(" 0 ")).toBe(0);
+		expect(boundedEventWatchTimeoutMs(0)).toBe(0);
+	});
+});
